# "api" talks to the Django API and Supabase Auth; "mock" runs fully in the browser
# (demo data in IndexedDB, local stand-in auth). Copy to .env.local for development.
VITE_DATA_MODE=api

# Supabase client credentials (public anon key only — never expose the service_role key).
# Local backend stack: http://localhost:54321 and JT_SUPABASE_ANON_KEY from
# ~/.local/share/jt-code-native/etc/secrets.env (see jt-code-backend docs/NATIVE_LOCAL_DEVELOPMENT.md).
VITE_SUPABASE_URL=https://ftfzkofptbtxscxsrcpl.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YkGBodz6iDo3GdIEgD_JsA_OkKBvivE

# Django API. Use /api when Vite proxy or same-origin reverse proxy is enabled.
VITE_API_BASE_URL=/api/v1

# Sentry browser DSN. Leave blank to disable telemetry locally.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Display metadata
VITE_APP_NAME=JT-Code
VITE_APP_VERSION=0.1.0
